PORT=5000
# Postgres connection string (Supabase pooler or any Postgres).
# Session mode (port 5432) is preferred for EF Core; transaction mode (6543)
# also works — ConnectionStringFactory disables prepared statements for it.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Apply sql/schema.sql on boot. Idempotent; enable on Render for first deploy.
RUN_MIGRATIONS=true
JWT_SECRET=<random-secret>
OPENAI_API_KEY=
# Set COMMS_DEV_MODE=true ONLY in development: OTP codes are logged instead of
# sent and returned in the API response. Must be false in production.
COMMS_DEV_MODE=false
# Print every OTP code to the terminal / Render logs while (or instead of, if
# no gateway is configured) sending the SMS. Set false once SMS delivery is trusted.
COMMS_LOG_OTP=true
COMMS_ENDPOINT=https://comms.egosms.co/api/v1/json/
COMMS_USERNAME=
COMMS_API_KEY=
COMMS_SENDER_ID=Ufundi
# Optional SMS gateway timeout in ms (default 15000)
COMMS_TIMEOUT_MS=15000
GOOGLE_WEB_CLIENT_ID=
GOOGLE_MAPS_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_VISION_MODEL=qwen/qwen3.6-27b
AI_BRAND_NAME=Ufundi
# Admin account re-seeded on every boot (web sign-in: email + password)
ADMIN_NAME=Ufundi Admin
ADMIN_EMAIL=admin@ufundi.ug
ADMIN_PASSWORD=<admin-password>
