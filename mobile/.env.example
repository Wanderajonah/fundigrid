# Copy to .env.local and set your machine's LAN IP (hostname -I)
# Android emulator: http://10.0.2.2:5000/api
# Deployed backend — used in development too, so the app works off any network.
EXPO_PUBLIC_API_URL=https://fundigrid.onrender.com/api
# Local backend instead? Uncomment one of these:
# EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:5000/api        # physical device (same Wi-Fi)
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api          # Android emulator

# Map provider — leave unset to use the built-in switch:
#   development → google (react-native-maps, works in Expo Go)
#   production  → maplibre (needs MapLibre's native code in the binary)
# EXPO_PUBLIC_MAP_PROVIDER=google
# Optional MapLibre style URL
# EXPO_PUBLIC_MAPLIBRE_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
