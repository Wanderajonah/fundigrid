{
  "expo": {
    "name": "FundiGrid",
    "slug": "fundigrid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fundigrid",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "translucent": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.finalyear2026.fundigrid",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FundiGrid uses your location to find nearby fundis and show live job tracking on the map."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyC1QY4aTwq8qyu4RXqsws8FOydzX2jZyuw"
      }
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.finalyear2026.fundigrid",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC1QY4aTwq8qyu4RXqsws8FOydzX2jZyuw"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-empty.png",
          "resizeMode": "contain",
          "backgroundColor": "#0D0D0D"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FundiGrid uses your location to find nearby fundis and show live job tracking on the map."
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "light",
          "enforceContrast": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "light"
      },
      "eas": {
        "projectId": "790d7c2d-e32f-4d6d-abbe-b911b5cf89ee"
      }
    },
    "owner": "finalyear2026"
  }
}
